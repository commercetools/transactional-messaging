{
  "name": "@commercetools-labs/notification-manager",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "start": "npm run compile-html && serve ./public -p 8080 --config ../serve.json",
    "start:dev": "mc-scripts start",
    "build": "mc-scripts build",
    "compile-html": "mc-scripts compile-html",
    "compile-html:local": "MC_APP_ENV=development mc-scripts compile-html --transformer @commercetools-frontend/mc-dev-authentication/transformer-local.js",
    "start:prod:local": "npm run compile-html:local && mc-scripts serve",
    "extract-intl": "formatjs extract --format=./intl-formatter.js --out-file=./src/i18n/data/core.json \"src/**/!(*.spec).(ts|tsx)\"",
    "test": "jest --config jest.test.config.js",
    "test:watch": "jest --config jest.test.config.js --watch",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "versions:appkit": "manypkg upgrade @commercetools-frontend"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@babel/core": "^7.28.0",
    "@babel/runtime-corejs3": "^7.28.0",
    "@chakra-ui/react": "^3.38.0",
    "@commercetools-frontend/actions-global": "27.17.1",
    "@commercetools-frontend/application-components": "27.17.1",
    "@commercetools-frontend/application-config": "27.17.1",
    "@commercetools-frontend/application-shell": "27.17.1",
    "@commercetools-frontend/application-shell-connectors": "27.17.1",
    "@commercetools-frontend/assets": "27.17.1",
    "@commercetools-frontend/babel-preset-mc-app": "27.17.1",
    "@commercetools-frontend/constants": "27.17.1",
    "@commercetools-frontend/i18n": "27.17.1",
    "@commercetools-frontend/l10n": "27.17.1",
    "@commercetools-frontend/mc-dev-authentication": "27.17.1",
    "@commercetools-frontend/mc-scripts": "27.17.1",
    "@commercetools-frontend/permissions": "27.17.1",
    "@commercetools/nimbus": "^3.8.0",
    "@commercetools/nimbus-icons": "^3.8.0",
    "formik": "^2.4.9",
    "graphql": "^16.11.0",
    "handlebars": "^4.7.10",
    "mjml-browser": "4.18.0",
    "omit-empty-es": "^1.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^7.1.14",
    "react-redux": "^9.2.0",
    "react-router-dom": "^5.3.4",
    "redux": "^5.0.1",
    "serve": "^14.2.8"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "devDependencies": {
    "@commercetools-frontend/eslint-config-mc-app": "27.17.1",
    "@commercetools-frontend/jest-preset-mc-app": "27.17.1",
    "@commercetools/platform-sdk": "^9.8.0",
    "@formatjs/cli": "^6.2.12",
    "@manypkg/cli": "^0.25.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-router-dom": "^5.3.3",
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "prettier": "^2.8.8",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}
