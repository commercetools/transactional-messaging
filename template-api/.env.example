# Local development only. In Connect, these come from connect.yaml and inheritAs.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_SCOPE=
CTP_API_URL=
CTP_AUTH_URL=

SENDGRID_API_KEY=
SENDGRID_DATA_RESIDENCY=global
CLOUD_IDENTIFIER=gcp-eu
ENTRY_POINT_URI_PATH=
# Public https URL of this service, used as the token audience. Leave empty locally: the Merchant Center proxy
# cannot reach localhost, so use TEMPLATE_API_DEV_MODE below. The service listens on PORT (default 8080).
TEMPLATE_API_PUBLIC_URL=
# Local development without the Merchant Center proxy: turns the token check off and listens on 127.0.0.1 only.
# Use it with TEMPLATE_API_DEV_URL in notification-manager/.env. Refused when deployed.
TEMPLATE_API_DEV_MODE=
